# ============================================================
# MoneyTracker — environment variables
# Copy to .env (never commit .env)
# ============================================================

# ------------------------------------------------------------------ #
# Option A: explicit DATABASE URLs (local docker-compose dev)         #
# ------------------------------------------------------------------ #
DATABASE_URL=postgresql+asyncpg://moneytracker:moneytracker@localhost:5432/moneytracker
DATABASE_URL_SYNC=postgresql://moneytracker:moneytracker@localhost:5432/moneytracker

# ------------------------------------------------------------------ #
# Option B: Vercel + Supabase native integration                      #
# These are injected automatically when you connect the Supabase      #
# integration in the Vercel marketplace dashboard.                    #
# The app derives DATABASE_URL / DATABASE_URL_SYNC from these if the  #
# explicit vars above are not set.                                    #
# ------------------------------------------------------------------ #
# POSTGRES_URL=postgresql://...          (pooled — Celery workers)
# POSTGRES_URL_NON_POOLING=postgresql://... (direct — asyncpg, Alembic)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# ------------------------------------------------------------------ #
# Redis                                                               #
# ------------------------------------------------------------------ #
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------ #
# Security                                                            #
# ------------------------------------------------------------------ #
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------ #
# Market Data APIs                                                    #
# ------------------------------------------------------------------ #
YAHOO_FINANCE_ENABLED=true
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# ------------------------------------------------------------------ #
# File Upload                                                         #
# ------------------------------------------------------------------ #
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------ #
# Scraping                                                            #
# ------------------------------------------------------------------ #
PLAYWRIGHT_HEADLESS=true

# ------------------------------------------------------------------ #
# App                                                                 #
# ------------------------------------------------------------------ #
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------ #
# Frontend (set in Vercel project settings, or .env.local)           #
# ------------------------------------------------------------------ #
# BACKEND_URL=https://your-backend.railway.app   (prod)
# BACKEND_URL=http://localhost:8000               (local, default)
