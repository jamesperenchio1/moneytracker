# Database
DATABASE_URL=postgresql+asyncpg://moneytracker:moneytracker@localhost:5432/moneytracker
DATABASE_URL_SYNC=postgresql://moneytracker:moneytracker@localhost:5432/moneytracker

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Market Data APIs
YAHOO_FINANCE_ENABLED=true
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=

# File Upload
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# Scraping
PLAYWRIGHT_HEADLESS=true

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
